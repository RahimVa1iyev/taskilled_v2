## Loading & Empty States

// ✅ Always handle all query states
function CourseList() {
  const { data, isLoading, isError, error } = useCourses(filters)

  if (isLoading) return <Spinner />
  if (isError) return <ErrorState message={parseApiError(error)} />
  if (!data?.data.length) return (
    <EmptyState
      title="Kurs tapılmadı"
      description="Axtarış parametrlərini dəyişdirin"
      action={{ label: 'Filtri təmizlə', onClick: clearFilters }}
    />
  )

  return <CourseGrid courses={data.data} />
}